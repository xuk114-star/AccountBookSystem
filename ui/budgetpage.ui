<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>BudgetPage</class>
 <widget class="QWidget" name="BudgetPage">
  <layout class="QVBoxLayout" name="mainLayout">
   <!-- 预算设置 -->
   <item>
    <widget class="QGroupBox" name="setBudgetGroup">
     <property name="title"><string>设置月度预算</string></property>
     <layout class="QHBoxLayout" name="setBudgetLayout">
      <item><widget class="QLabel" name="budgetLabel"><property name="text"><string>每月预算（元）</string></property></widget></item>
      <item><widget class="QDoubleSpinBox" name="budgetSpinBox"><property name="maximum"><double>99999999.99</double></property><property name="decimals"><number>2</number></property><property name="value"><double>3000.00</double></property></widget></item>
      <item><widget class="QPushButton" name="setBudgetButton"><property name="text"><string>设置预算</string></property></widget></item>
     </layout>
    </widget>
   </item>

   <!-- 预算状态 -->
   <item>
    <widget class="QGroupBox" name="statusGroup">
     <property name="title"><string>预算执行情况</string></property>
     <layout class="QGridLayout" name="statusGrid">
      <item row="0" column="0"><widget class="QLabel" name="l1"><property name="text"><string>月度预算：</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="budgetAmountLabel"><property name="text"><string>¥ 0.00</string></property><property name="font"><font><pointsize>14</pointsize><weight>75</weight><bold>true</bold></font></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="l2"><property name="text"><string>本月已支出：</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel" name="currentSpendingLabel"><property name="text"><string>¥ 0.00</string></property><property name="font"><font><pointsize>14</pointsize></font></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="l3"><property name="text"><string>剩余额度：</string></property></widget></item>
      <item row="2" column="1"><widget class="QLabel" name="remainingLabel"><property name="text"><string>¥ 0.00</string></property><property name="font"><font><pointsize>14</pointsize></font></property></widget></item>
     </layout>
    </widget>
   </item>

   <!-- 进度条 -->
   <item>
    <widget class="QGroupBox" name="progressGroup">
     <property name="title"><string>预算使用进度</string></property>
     <layout class="QVBoxLayout" name="progressLayout">
      <item><widget class="QProgressBar" name="progressBar"><property name="value"><number>0</number></property><property name="textVisible"><bool>true</bool></property></widget></item>
      <item><widget class="QLabel" name="progressPercentLabel"><property name="text"><string>0.0%</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
     </layout>
    </widget>
   </item>

   <!-- 状态提醒 -->
   <item>
    <widget class="QGroupBox" name="alertGroup">
     <property name="title"><string>状态提醒</string></property>
     <layout class="QVBoxLayout" name="alertLayout">
      <item><widget class="QLabel" name="statusLabel"><property name="text"><string>加载中...</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
     </layout>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout">
     <item><spacer name="hSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
     <item><widget class="QPushButton" name="refreshButton"><property name="text"><string>刷新数据</string></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>
</ui>
