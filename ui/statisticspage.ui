<ui version="4.0">
 <class>StatisticsPage</class>
 <widget class="QWidget" name="StatisticsPage">
  <layout class="QVBoxLayout" name="mainLayout">
   <!-- 统计汇总 -->
   <item>
    <widget class="QGroupBox" name="summaryGroup">
     <property name="title"><string>收支概览</string></property>
     <layout class="QGridLayout" name="summaryGrid">
      <item row="0" column="0"><widget class="QLabel" name="l1"><property name="text"><string>区间总收入：</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="totalIncomeLabel"><property name="text"><string>0.00</string></property></widget></item>
